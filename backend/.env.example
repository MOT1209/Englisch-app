# Database (Neon PostgreSQL)
DATABASE_URL="postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/linguaverse?sslmode=require"

# JWT
JWT_SECRET="your-super-secret-key-change-this"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Server
PORT=3000
NODE_ENV=development

# CORS
CORS_ORIGIN="http://localhost:3000"

# Gemini (server-side only ظ¤ NEVER put this in the Android app's .env/.env.example)
GEMINI_API_KEY="AIzaSy-your-real-gemini-key"
GEMINI_MODEL="gemini-2.5-flash"

# Shared secret the Android app must send as `X-App-Token` when calling /api/ai/*
# (use a long random string, not "change-me-strong-app-token", in production).
APP_TOKEN="change-me-strong-app-token"

# Daily AI request cap per caller (device id or IP). Protects your Gemini quota.
AI_DAILY_REQUEST_CAP="300"
