# Database (Neon PostgreSQL)
DATABASE_URL="postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/linguaverse?sslmode=require"

# JWT
JWT_SECRET="your-super-secret-key-change-this"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Server
PORT=3000
NODE_ENV=development

# CORS
CORS_ORIGIN="http://localhost:3000"

# ---------------------------------------------------------------------------
# AI providers (server-side only. NEVER put these in the Android app's .env)
#
# The tutor endpoints walk this list in order and use the first provider that
# answers, so a dead key or an exhausted free tier degrades instead of failing.
# Any provider without a key is skipped. Known ids: gemini, groq, zen.
# ---------------------------------------------------------------------------
AI_PROVIDER_ORDER="gemini,groq,zen"
AI_REQUEST_TIMEOUT_MS="25000"

# Google Gemini (native API) — https://aistudio.google.com/apikey
GEMINI_API_KEY="AIzaSy-your-real-gemini-key"
GEMINI_MODEL="gemini-2.5-flash"

# Groq (OpenAI-compatible) — https://console.groq.com/keys
GROQ_API_KEY="gsk_your-real-groq-key"
GROQ_MODEL="openai/gpt-oss-120b"
GROQ_BASE_URL="https://api.groq.com/openai/v1"

# OpenCode Zen gateway — https://opencode.ai/zen
# Its OpenAI-compatible surface is /zen/v1/chat/completions, so pick a model Zen
# serves there (deepseek-v4-flash, glm-5.3-flash, kimi-k2.5, minimax-m2.7, ...).
OPENCODE_ZEN_API_KEY="sk-your-real-opencode-zen-key"
OPENCODE_ZEN_MODEL="deepseek-v4-flash"
OPENCODE_ZEN_BASE_URL="https://opencode.ai/zen/v1"

# Shared secret the Android app must send as `X-App-Token` when calling /api/ai/*
# (use a long random string, not "change-me-strong-app-token", in production).
# NOTE: this is the FALLBACK gate. Configure Firebase App Check below and the
# token is ignored — a leaked secret then buys nothing.
APP_TOKEN="change-me-strong-app-token"

# Daily AI request cap per caller (device id or IP). Protects your provider quota.
AI_DAILY_REQUEST_CAP="300"

# ---------------------------------------------------------------------------
# Firebase App Check (recommended, replaces the shared APP_TOKEN)
#
# Set the GCP project number (e.g. 1234567890 — the number, not the project id)
# and the AI proxy will require a verified App Check token in the
# `X-Firebase-AppCheck` header and stop accepting X-App-Token entirely.
#   - Backend: nothing else needed — tokens are verified against Google's JWKS.
#   - Android: enable the App Check SDK in app/build.gradle.kts and add the
#     `google-services.json` from your Firebase project, then the app attaches a
#     token to every call. For local/dev builds use the debug provider token.
# Leave unset to keep using APP_TOKEN.
FIREBASE_APP_CHECK_PROJECT_NUMBER=""
